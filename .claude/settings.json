{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_repo_sync.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Bash(git *)",
      "Bash(python -m pytest *)",
      "Bash(gh *)"
    ]
  }
}
